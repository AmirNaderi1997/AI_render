        <UI>
          <Type>Panel</Type>
          <Menu>AI Render Bridge</Menu>
          <Geometry>
            <Size><Height>360</Height><Width>420</Width></Size>
            <MinSize><Height>300</Height><Width>340</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
