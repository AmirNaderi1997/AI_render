    <Extension Id="ir.airender.premiere.bridge.panel" Version="0.1.1" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList><Host Name="PPRO" Version="[25.0,25.6)" /></HostList>
    <LocaleList><Locale Code="All" /></LocaleList>
    <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="11.0" /></RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
