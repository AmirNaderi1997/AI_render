<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="ir.airender.premiere.bridge"
  ExtensionBundleVersion="0.1.1" ExtensionBundleName="AI Render Premiere Bridge"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
