  ],
  "sentences": [
    {
      "text": "این دو، این یک، این دو rekord زدی الان دوباره؟",
      "start": 0.0,
      "end": 6.56
    },
    {
      "text": "آره راحت‌تر نمیومد آره.",
      "start": 6.7,
      "end": 10.54
    },
    {
      "text": "چهارده رو اسکیپ می‌کنیم میایم رو پونزده.",
      "start": 18.1,
      "end": 20.12
    },
    {
      "text": "اگر قرار باشه انتخاب کنید که یک محصول رو ارائه بدید یا یک خدمات، کدومش رو انتخاب می‌کنید؟",
      "start": 25.08,
      "end": 31.44
    },
    {
      "text": "ببین اگر از صفر بخوام شروع بکنم خدمات می‌فروشم ولی قطعاً دید و نگرشم اینه که روی فروش خدمات نمونم.",
      "start": 32.34,
      "end": 40.0
    },
    {
      "text": "چرا؟",
      "start": 40.48,
      "end": 40.7
    },
    {
      "text": "به خاطر اینکه فروش خدمات سرمایه اولیه اصولا نمیخواد.",
      "start": 40.84,
      "end": 45.52
    },
    {
      "text": "تو یه مهارتی داری که می‌تونی بری بفروشی.",
      "start": 45.56,
      "end": 47.74
    },
    {
      "text": "لازم نیست تبلیغات خاصی انجام بدی.",
      "start": 47.8,
      "end": 50.2
    },
    {
      "text": "لازم نیست پلتفرم خاصی ایجاد بکنی.",
      "start": 50.24,
      "end": 53.5
    },
    {
      "text": "اصولا هزینه‌های اولیه نداره و به واسطه اینکه این هزینه‌های اولیه و زیرساخت اولیه لازم نیست بسازی",
      "start": 53.54,
      "end": 60.48
    }
  ]
}