  "sentences": [
    {
      "text": "این دو، این یک، این دو",
      "start": 0.0,
      "end": 3.48
    },
    {
      "text": "رکرد زدی اینلان دوباره؟",
      "start": 5.21,
      "end": 6.65
    },
    {
      "text": "آره",
      "start": 6.65,
      "end": 7.35
    },
    {
      "text": "منتر نمی کنیم",
      "start": 9.2,
      "end": 10.22
    },
    {
      "text": "آره",
      "start": 10.22,
      "end": 11.12
    },
    {
      "text": "چارده را اسکیب می کنیم این رو پونوزم",
      "start": 17.94,
      "end": 20.58
    },
    {
      "text": "اگر قرار باشه انتخاب کنید",
      "start": 24.74,
      "end": 27.08
    },
    {
      "text": "که یک مخصول رو ایرایه بدید یا یک خدمات",
      "start": 27.08,
      "end": 29.84
    },
    {
      "text": "کدومش ها انتخاب می کنیم",
      "start": 30.12,
      "end": 31.6
    },
    {
      "text": "ببین اگه از صف می خوام شروع بکنم",
      "start": 32.26,
      "end": 34.74
    },
    {
      "text": "خدمات می فوشم",
      "start": 34.74,
      "end": 35.9
    },
    {
      "text": "ولی قطعاً دیدید و نگرشم اینکه روی فروش خدمات نمونم",
      "start": 35.9,
      "end": 39.84
    },
    {
      "text": "چرا؟ بخاطر اینکه فروش خدمات",
      "start": 39.84,
      "end": 43.24
    },
    {
      "text": "سرمایی اولیه اصلاً نمیخوا",
      "start": 43.24,
      "end": 45.5
    },
    {
      "text": "توی مهارتی داری که میچنی بری بفشی",
      "start": 45.5,
      "end": 47.78
    },
    {
      "text": "لازم نیست",
      "start": 47.78,
      "end": 48.54
    },
    {
      "text": "تبلیغات خواستی انجام بودی",
      "start": 48.54,
      "end": 50.24
    },
    {
      "text": "لازم نیست",
      "start": 50.24,
      "end": 50.96
    },
    {
      "text": "پلتفرم خواستی ایجاد بکنی",
      "start": 51.68,
      "end": 53.52
    },
    {
      "text": "اصلاً حزنهای اولیه نداره",
      "start": 53.52,
      "end": 56.14
    },
    {
      "text": "و بباسطه اینکه این حزنهای اولیه و زیوی ساخت",
      "start": 56.14,
      "end": 59.26
    },
    {
      "text": "اولیه لازم نیست",
      "start": 59.26,
      "end": 60.32
    }
  ]
}