# LLM provider: anthropic | openai | openai_compatible | jarvis
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5

# Anthropic (default provider)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (alternative)
# OPENAI_API_KEY=sk-...

# Jarvis (jarvis.you — OpenAI-compatible)
# JARVIS_API_KEY=pmai_...
# JARVIS_BASE_URL=https://api.jarvis.you/v1

# Generic OpenAI-compatible provider (LLM_PROVIDER=openai_compatible)
# LLM_API_KEY=...
# LLM_BASE_URL=https://...

# Whisper model size: small (default), medium, large-v3
WHISPER_MODEL=small
